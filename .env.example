# =====================================================================
# Drug Leaflet RAG Agent — Environment Variables
# Copy this file to .env and fill in the values before running.
# =====================================================================

# --- App ---
APP_ENV=development
APP_NAME="Drug Leaflet Agent"
LOG_LEVEL=INFO

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Auth (JWT) ---
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=drugagent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/drugagent

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- ChromaDB ---
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- File Storage ---
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=20

# --- OCR ---
# PaddleOCR languages: en, german, ch, ...
OCR_LANGUAGES=en,german

# --- LLM / Embedding (Google Gemini) ---
# Get free API key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# --- Reranker (local BGE) ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5

# --- RAG ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=10

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
